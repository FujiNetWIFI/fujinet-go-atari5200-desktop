      <caption>The FujiNet CONFIG client running on the console</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-atari5200-desktop/v0.1.0/data/screenshots/kde/1_running_config.png</image>
    </screenshot>
    <screenshot>
      <caption>The debugger: disassembly with the BIOS's labels</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-atari5200-desktop/v0.1.0/data/screenshots/kde/2_debugger.png</image>
    </screenshot>
    <screenshot>
      <caption>The Controllers window: the 5200 controller with its keypad</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-atari5200-desktop/v0.1.0/data/screenshots/kde/3_controllers.png</image>
    </screenshot>
  </screenshots>
  <url type="homepage">https://fujinet.online/</url>
  <url type="bugtracker">https://github.com/FujiNetWIFI/fujinet-go-atari5200-desktop/issues</url>
  <url type="vcs-browser">https://github.com/FujiNetWIFI/fujinet-go-atari5200-desktop</url>
  <developer id="online.fujinet">
    <name>FujiNet</name>
  </developer>
  <content_rating type="oars-1.1"/>
  <releases>
    <!-- The CURRENT release templates its version from @PROJECT_VERSION@, so
         it cannot disagree with the tree; past releases are literal and go
         above it as they are made. The release job checks that this first
         entry is still a template. -->
    <release version="@PROJECT_VERSION@" date="2026-11-03">
      <description>
        <p>
          The icon is back on the FujiNet family's rounded square and mark, in
          the 5200's black and silver, in every package and on every platform.
        </p>
      </description>
    </release>
    <release version="0.1.0" date="2026-11-02">
      <description>
        <p>
          First release: atari800 in 5200 mode with the FujiNet cartridge and
          an in-process FujiNet over BoIP, the built-in Altirra 5200 OS, BIOS
          import, native GNOME, KDE, macOS and Windows frontends, the
          controller with its keypad on screen, hotplugged gamepads and a
          native debugger.
        </p>
      </description>
    </release>
  </releases>
</component>
